{
  "manifest_version": 3,
  "name": "TabView",
  "version": "3.1",
  "description": "Visual tab manager with RAM monitoring, multi-select, tab grouping, window management, and AI-assisted organization.",
  "permissions": ["tabs", "activeTab", "debugger", "tabGroups", "storage", "alarms", "contextMenus", "nativeMessaging"],
  "host_permissions": ["https://api.anthropic.com/*", "https://openrouter.ai/*", "https://raw.githubusercontent.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Open TabView"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
